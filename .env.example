# ==============================================================================
# Veritas Content Intelligence Ecosystem — Environment Variables (.env.example)
# ==============================================================================
# Copy this file to `.env` for local or Docker Compose deployments:
#   cp .env.example .env
# NEVER commit `.env` or real API keys/passwords to version control.
# All variables below are OPTIONAL unless marked [REQUIRED FOR DOCKER POSTGRES].
# When zero cloud API keys are set, Veritas runs 100% locally via Tier #1 OSS
# stylometry & heuristics (zero external network calls).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Runtime Configuration (Optional)
# ------------------------------------------------------------------------------
# HTTP port exposed by Express + Vite/static UI (Default: 3000)
PORT="3000"

# Runtime mode: "development" or "production" (Default: development)
# NODE_ENV="production"

# Public canonical URL of your deployment (Default: inferred from request Host)
# Security: Used for OpenAPI server metadata, LTI 1.3 redirects, and badge URLs.
APP_URL="MY_APP_URL"

# Path for local JSON persistence store when Postgres is not configured
# (Default: ./data/veritas-store.json)
# VERITAS_DATA_DIR="./data"

# Maximum file upload size in bytes for /api/v1/analyze-media & /api/v1/detect/batch
# (Default: 104857600 = 100 MB; increase on dedicated nodes as RAM permits)
# VERITAS_MAX_FILE_BYTES="104857600"

# Maximum files allowed per single multipart batch request (Default: 100)
# VERITAS_MAX_BATCH_FILES="100"

# Maximum JSON request body size (Default: "10mb")
# VERITAS_JSON_LIMIT="10mb"

# ------------------------------------------------------------------------------
# 2. Security, Authentication & Rate Limiting (Recommended for Production)
# ------------------------------------------------------------------------------
# Enforce Bearer / x-api-key authentication on protected /api/v1/* endpoints.
# Recommendation: Set to "true" before exposing Veritas to the public internet.
# (Default: "false" for friction-free local self-hosting)
VERITAS_REQUIRE_AUTH="false"

# Global sliding-window IP rate limit (requests per minute per IP) (Default: 600)
VERITAS_GLOBAL_RPM="600"

# Send `X-Frame-Options: DENY` header to prevent clickjacking in standalone
# deployments. Keep "false" when embedded in iframe-based workspaces or LTI LMS.
# (Default: "false")
VERITAS_FRAME_DENY="false"

# ------------------------------------------------------------------------------
# 3. Docker Compose & PostgreSQL / Redis Persistence
# ------------------------------------------------------------------------------
# [REQUIRED FOR DOCKER COMPOSE]: Strong database password for Postgres container.
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD="CHANGE_ME_STRONG_LOCAL_DB_PASSWORD"

# Optional external PostgreSQL & Redis connection URIs
# DATABASE_URL="postgresql://veritas:CHANGE_ME@postgres:5432/veritas"
# REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# 4. Local-First Open-Source AI Inference (Tiers 2-4, Zero-Cost Priority)
# ------------------------------------------------------------------------------
# Tier #2: Ollama (https://ollama.com)
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.2"

# Tier #3: vLLM OpenAI-compatible server
# VLLM_BASE_URL="http://127.0.0.1:8000"
# VLLM_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# Tier #4: LM Studio local server
# LMSTUDIO_BASE_URL="http://127.0.0.1:1234"
# LMSTUDIO_MODEL="llama-3.2-8b-instruct"

# Optional local OCR & Speech-to-Text microservices (used in Docker Compose)
# WHISPER_ASR_URL="http://127.0.0.1:9000"
# TESSERACT_URL="http://127.0.0.1:8884"

# ------------------------------------------------------------------------------
# 5. Cloud Failover AI Providers & Credit Guardrails (Tiers 5-11, All Optional)
# ------------------------------------------------------------------------------
# Server automatically detects 402 Payment Required, RESOURCE_EXHAUSTED,
# QUOTA_EXCEEDED, RATE_LIMIT_EXCEEDED, BILLING_DISABLED, and INSUFFICIENT_CREDITS
# and fails over across configured providers or back to local OSS inference.

# Tier #5: OpenRouter
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# OPENROUTER_CREDIT_BUDGET_USD="25"

# Tier #6: Google Gemini (Required only if enabling cloud Gemini features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_CREDIT_BUDGET_USD="50"

# Tier #7: OpenAI
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_CREDIT_BUDGET_USD="50"

# Tier #8: Anthropic
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"
# ANTHROPIC_CREDIT_BUDGET_USD="50"

# Tier #9: Groq
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_CREDIT_BUDGET_USD="25"

# Tier #10: Together AI
# TOGETHER_API_KEY=""
# TOGETHER_MODEL="Qwen/Qwen2.5-72B-Instruct-Turbo"
# TOGETHER_CREDIT_BUDGET_USD="25"

# Tier #11: Any Custom OpenAI-Compatible Inference Endpoint
# CUSTOM_AI_BASE_URL=""
# CUSTOM_AI_API_KEY=""
# CUSTOM_AI_MODEL="custom-oss-model"
# CUSTOM_AI_CREDIT_BUDGET_USD="25"
