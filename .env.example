# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Self-Hosted Security & Postgres Docker Settings
# POSTGRES_PASSWORD="CHANGE_ME_STRONG_LOCAL_DB_PASSWORD"
# VERITAS_REQUIRE_AUTH="false"
# VERITAS_GLOBAL_RPM="600"
# VERITAS_FRAME_DENY="false"

# Optional Local-First Open-Source Inference Servers (Zero-Cost Priority)
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.2"
# VLLM_BASE_URL="http://127.0.0.1:8000"
# VLLM_MODEL="meta-llama/Llama-3.3-70B-Instruct"
# LMSTUDIO_BASE_URL="http://127.0.0.1:1234"
# LMSTUDIO_MODEL="llama-3.2-8b-instruct"

# Optional Cloud Failover Providers & Preemptive Credit Guardrails
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# OPENROUTER_CREDIT_BUDGET_USD="25"
# GEMINI_CREDIT_BUDGET_USD="50"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_CREDIT_BUDGET_USD="50"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"
# ANTHROPIC_CREDIT_BUDGET_USD="50"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_CREDIT_BUDGET_USD="25"
# TOGETHER_API_KEY=""
# TOGETHER_MODEL="Qwen/Qwen2.5-72B-Instruct-Turbo"
# TOGETHER_CREDIT_BUDGET_USD="25"
# CUSTOM_AI_BASE_URL=""
# CUSTOM_AI_API_KEY=""
# CUSTOM_AI_MODEL="custom-oss-model"
# CUSTOM_AI_CREDIT_BUDGET_USD="25"
