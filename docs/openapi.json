{
  "openapi": "3.1.0",
  "info": {
    "title": "Veritas Content Intelligence, Security & Provenance API",
    "version": "3.0.0",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "description": "Open-source, self-hosted REST + SSE + MCP + LTI 1.3 ecosystem for AI text/code/media detection, adversarial evasion defense, cryptographic Ed25519 human-authorship proofs, non-reversible author stylometric twins, grounded fact-checking & citation entailment, cross-lingual plagiarism, SEO/GEO optimization, privacy airlock controls, and 11-tier AI provider failover routing."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local / Self-Hosted Node"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Pass x-api-key or Authorization: Bearer vrt_live_... for headless API clients with per-key RPM rate limits."
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness & readiness health check probe",
        "responses": {
          "200": {
            "description": "Service status ok + MIT license metadata"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "OpenAPI 3.1 JSON specification",
        "responses": {
          "200": {
            "description": "Complete OpenAPI 3.1 JSON document"
          }
        }
      }
    },
    "/api/docs": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Interactive self-hosted API Explorer & Swagger documentation UI",
        "responses": {
          "200": {
            "description": "Self-contained HTML OpenAPI reference explorer"
          }
        }
      }
    },
    "/api/v1/detect": {
      "post": {
        "tags": [
          "Core Forensics"
        ],
        "summary": "Run full Content Intelligence scan (AI, Authenticity, Quality, GEO/SEO, Academic Integrity, Adversarial Security & AI-Spin)",
        "responses": {
          "200": {
            "description": "Complete DetectionRecord intelligence report"
          }
        }
      }
    },
    "/api/v1/analyze-media": {
      "post": {
        "tags": [
          "Core Forensics"
        ],
        "summary": "Analyze document (PDF/DOCX/TXT/RTF/ODT), image (PNG/JPG/WEBP/TIFF), audio, or video file",
        "responses": {
          "200": {
            "description": "DetectionRecord with mediaForensics breakdown"
          }
        }
      }
    },
    "/api/v1/detect/batch": {
      "post": {
        "tags": [
          "Core Forensics"
        ],
        "summary": "Queue unlimited document or media files for parallel processing",
        "responses": {
          "202": {
            "description": "Queued job object with SSE stream URL"
          }
        }
      }
    },
    "/api/v1/analyze-url": {
      "post": {
        "tags": [
          "Core Forensics"
        ],
        "summary": "Crawl 1-10 same-origin web pages and run full Content Intelligence analysis",
        "responses": {
          "200": {
            "description": "Crawled DetectionRecord results"
          }
        }
      }
    },
    "/api/v1/humanize": {
      "post": {
        "tags": [
          "Quality & Research"
        ],
        "summary": "Humanize prose at light/moderate/aggressive intensity and automatically re-verify",
        "responses": {
          "200": {
            "description": "Humanized revision with before/after detection scores"
          }
        }
      }
    },
    "/api/v1/fact-check": {
      "post": {
        "tags": [
          "Quality & Research"
        ],
        "summary": "Verify factual claims and source credibility using web grounding or local fallback",
        "responses": {
          "200": {
            "description": "FactCheckReport with claim verdicts and verified sources"
          }
        }
      }
    },
    "/api/v1/plagiarism-web": {
      "post": {
        "tags": [
          "Quality & Research"
        ],
        "summary": "Cross-check distinctive passages against indexed web pages",
        "responses": {
          "200": {
            "description": "Matched external URLs and overlapping excerpts"
          }
        }
      }
    },
    "/api/v1/plagiarism-crosslingual": {
      "post": {
        "tags": [
          "Quality & Research"
        ],
        "summary": "Detect translated / cross-language plagiarism across major world languages",
        "responses": {
          "200": {
            "description": "CrossLingualMatch results"
          }
        }
      }
    },
    "/api/v1/citations/entailment": {
      "post": {
        "tags": [
          "Quality & Research"
        ],
        "summary": "Verify semantic entailment between a factual claim and its cited source URL",
        "responses": {
          "200": {
            "description": "CitationEntailmentResult (Supported / Contradicted / Not Found)"
          }
        }
      }
    },
    "/api/v1/seo-analyze": {
      "post": {
        "tags": [
          "Quality & Research"
        ],
        "summary": "Run SEO optimization & Generative Engine Optimization (GEO) audit",
        "responses": {
          "200": {
            "description": "SeoAnalysisReport + GeoAnalysisReport"
          }
        }
      }
    },
    "/api/v1/exclusions/recalculate": {
      "post": {
        "tags": [
          "Quality & Research"
        ],
        "summary": "Recalculate AI & plagiarism scores excluding quotes, bibliographies, headers, and matches < N words",
        "responses": {
          "200": {
            "description": "FilteredScoreResult"
          }
        }
      }
    },
    "/api/v1/citations": {
      "get": {
        "tags": [
          "Citations"
        ],
        "summary": "List saved bibliographic citations in the local vault",
        "responses": {
          "200": {
            "description": "CitationEntry[]"
          }
        }
      },
      "post": {
        "tags": [
          "Citations"
        ],
        "summary": "Save a citation entry to the bibliography vault",
        "responses": {
          "201": {
            "description": "Created CitationEntry"
          }
        }
      }
    },
    "/api/v1/citations/lookup": {
      "post": {
        "tags": [
          "Citations"
        ],
        "summary": "Resolve bibliographic metadata from a title, DOI, or URL",
        "responses": {
          "200": {
            "description": "Verified CitationEntry metadata"
          }
        }
      }
    },
    "/api/v1/citations/{id}": {
      "delete": {
        "tags": [
          "Citations"
        ],
        "summary": "Delete a saved citation entry from the bibliography vault",
        "responses": {
          "200": {
            "description": "Deletion confirmation"
          }
        }
      }
    },
    "/api/v1/security/inspect": {
      "post": {
        "tags": [
          "Security & Code"
        ],
        "summary": "Run adversarial evasion (zero-width, homoglyphs, Bidi, prompt-injection) and PII airlock inspection",
        "responses": {
          "200": {
            "description": "AdversarialSecurityReport and redacted preview"
          }
        }
      }
    },
    "/api/v1/code-reports": {
      "get": {
        "tags": [
          "Security & Code"
        ],
        "summary": "List saved AI source-code & AST forensics reports",
        "responses": {
          "200": {
            "description": "CodeAnalysisReport[]"
          }
        }
      }
    },
    "/api/v1/analyze-code": {
      "post": {
        "tags": [
          "Security & Code"
        ],
        "summary": "Detect AI-generated source code, compute variable-rename-invariant AST fingerprint, and audit SPDX OSS licenses",
        "responses": {
          "200": {
            "description": "CodeAnalysisReport"
          }
        }
      }
    },
    "/api/v1/authorship/profiles": {
      "get": {
        "tags": [
          "Provenance & Authorship"
        ],
        "summary": "List non-reversible Author Stylometric Twin profiles",
        "responses": {
          "200": {
            "description": "AuthorStylometricProfile[]"
          }
        }
      },
      "post": {
        "tags": [
          "Provenance & Authorship"
        ],
        "summary": "Enroll or update a privacy-preserving Author Stylometric Twin vector",
        "responses": {
          "201": {
            "description": "AuthorStylometricProfile"
          }
        }
      }
    },
    "/api/v1/authorship/profiles/{id}": {
      "delete": {
        "tags": [
          "Provenance & Authorship"
        ],
        "summary": "Delete an enrolled Author Stylometric Twin profile",
        "responses": {
          "200": {
            "description": "Deletion confirmation"
          }
        }
      }
    },
    "/api/v1/authorship/verify": {
      "post": {
        "tags": [
          "Provenance & Authorship"
        ],
        "summary": "Compare new submission stylometric vector against baseline author twin for contract cheating/drift",
        "responses": {
          "200": {
            "description": "AuthorDriftVerification"
          }
        }
      }
    },
    "/api/v1/proofs": {
      "get": {
        "tags": [
          "Provenance & Authorship"
        ],
        "summary": "List minted Ed25519 Veritas Proof cryptographic attestation bundles",
