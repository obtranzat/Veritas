#!/usr/bin/env sh
# Veritas Pre-Commit Secret & Credential Guard
# Install with: npm run hooks:install

set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED_FILES" ] && exit 0

# 1. Block committing forbidden secret, key, certificate, or runtime store files
FORBIDDEN_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '(^|/)\.env($|\.[^e])|\.pem$|\.key$|\.p12$|\.pfx$|credentials\.json$|secrets\.json$|^data/.*\.json$|^k8s/secret\.yaml$|^private/|^backups/' || true)
if [ -n "$FORBIDDEN_FILES" ]; then
  echo "BLOCKED [Veritas Security Hook]: Attempted to commit forbidden secret/credential file(s):"
  printf '%s\n' "$FORBIDDEN_FILES"
  echo "Remove from staging with: git reset HEAD <file>"
  exit 1
fi

# 2. Scan staged diff added lines for known credential & private key patterns
ADDED_DIFF=$(git diff --cached -U0 --diff-filter=ACM | grep -E '^\+[^+]' || true)
if [ -n "$ADDED_DIFF" ]; then
  if printf '%s\n' "$ADDED_DIFF" | grep -qE 'AIza[0-9A-Za-z_-]{15,}|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|glpat-[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|vrt_live_[A-Za-z0-9_]{20,}'; then
    echo "BLOCKED [Veritas Security Hook]: Potential API key, token, or private key detected in staged diff!"
    echo "Replace secrets with environment variables and placeholder values in .env.example."
    exit 1
  fi
fi

# 3. Run Gitleaks if installed locally
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config=.gitleaks.toml --redact
fi

exit 0
