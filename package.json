{
  "name": "veritas-content-intelligence",
  "version": "3.0.0",
  "description": "Open-source, self-hosted AI content detection, multimodal media forensics, web crawler, cryptographic provenance, humanization, and 11-tier AI failover platform.",
  "license": "MIT",
  "homepage": "https://github.com/obtranzat/Veritas#readme",
  "bugs": {
    "url": "https://github.com/obtranzat/Veritas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obtranzat/Veritas.git"
  },
  "keywords": [
    "ai-detection",
    "content-intelligence",
    "plagiarism-detection",
    "humanizer",
    "stylometry",
    "ed25519",
    "mcp",
    "lti-1.3",
    "self-hosted",
    "ollama"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "test:ai": "vitest run tests/ai",
    "test:e2e": "vitest run tests/api tests/security",
    "test:perf": "node scripts/benchmark.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "validate:release": "npm run lint && npm run test:coverage && npm run build",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "docx": "^9.16.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "unpdf": "^2.2.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
